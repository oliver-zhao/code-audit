{
  "name": "code-audit",
  "version": "0.2.0",
  "private": true,
  "description": "Deterministic source-code security scanner (rules, secrets, dependency advisories) with a CLI and an MCP server for agent-assisted review",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliver-zhao/code-audit.git"
  },
  "homepage": "https://github.com/oliver-zhao/code-audit#readme",
  "bugs": {
    "url": "https://github.com/oliver-zhao/code-audit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b && vitest run",
    "typecheck": "tsc -b --pretty false",
    "link:local": "node scripts/link-local.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "pack:verify": "node scripts/verify-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
