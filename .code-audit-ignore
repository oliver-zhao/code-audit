# Ignore file for scanning this repository with its own tool:
#
#   ./bin/code-audit scan . --offline --no-external
#
# The repository contains deliberately vulnerable samples and fake credentials
# (the fixtures and the inputs of the tests), which would otherwise dominate
# the result. Every entry needs a reason. Suppressed findings stay listed in
# the report ("Suppressed findings") and in findings.json, and the scan prints
# a WARNING with their number; `--no-ignore-file` or `--untrusted` shows
# everything again. See README.md, "Ignore file".
version: 1
ignore:
  - paths: ["fixtures/vulnerable/**"]
    reason: "Seeded vulnerabilities and fake credentials that the rule tests must find (fixtures/vulnerable/EXPECTED.json)."
  - paths: ["fixtures/clean/**"]
    reason: "Safe counterparts of the seeds; the remaining low-confidence hotspots there are intended."
  - paths: ["packages/core/test/**", "packages/mcp/test/**"]
    reason: "Test inputs: vulnerable snippets and fake credentials written into temporary projects by the tests."
  - paths: ["examples/dsh-demo/src/**", "examples/opencode-demo/src/**", "examples/demo-app/**"]
    reason: "Deliberately vulnerable demo applications (and the sample report of one) used to try the tool and the host adapters."
  - paths: ["_private/**"]
    reason: "Local-only development records (git-ignored, never published); one quotes the fake fixture tokens."
  - rule: "secret-generic-assignment"
    paths: ["packages/core/src/placeholder.ts", "packages/core/src/external/gitleaks.ts", "packages/core/src/redact.ts", "docs/skill-scan.md"]
    reason: "Comments that show what a password assignment looks like to the detector; the values are made-up examples."
  - rule: "secret-url-credentials"
    paths: ["packages/core/src/placeholder.ts", "packages/core/src/redact.ts", "docs/security-model.md"]
    reason: "Comments and documentation describing the scheme://user:password@host form (reported under --untrusted, which keeps placeholder confidence)."
  - rule: "secret-aws-access-key"
    paths: ["packages/core/src/placeholder.ts"]
    reason: "AWS's published documentation key id (AKIAIOSFODNN7EXAMPLE) in the list of known example values."
  - rule: "js-ssrf"
    paths: ["packages/core/src/sca.ts"]
    reason: "The HTTP client is only called with the constant OSV.dev endpoints; the advisory id in the path is URL-encoded."
  - rule: "dep-missing-lockfile"
    paths: ["packages/*/package.json"]
    reason: "pnpm workspace: the lockfile is pnpm-lock.yaml in the repository root."
  - rule: "secret-generic-assignment"
    paths: ["rules/**"]
    reason: "Rule definitions: regular expressions that list password-like words (for example DEV_SECRET in rules/iac/compose.yml), not credentials."
