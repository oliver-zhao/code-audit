{
  "name": "@code-audit/mcp",
  "version": "0.2.0",
  "description": "code-audit MCP server (stdio): audit_* tools for agent hosts",
  "keywords": [
    "security",
    "audit",
    "sast",
    "sca",
    "secrets",
    "sarif",
    "mcp",
    "code-review"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliver-zhao/code-audit.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/oliver-zhao/code-audit#readme",
  "bugs": {
    "url": "https://github.com/oliver-zhao/code-audit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "code-audit-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "prepack": "node ../../scripts/pack-assets.mjs",
    "postpack": "node ../../scripts/pack-assets.mjs --clean"
  },
  "dependencies": {
    "@code-audit/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.24.0"
  }
}
