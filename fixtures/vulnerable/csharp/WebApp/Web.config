<?xml version="1.0" encoding="utf-8"?>
<!-- Seeded ASP.NET configuration weaknesses; every hit is listed in EXPECTED.json. -->
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <customErrors mode="Off" />
    <httpCookies httpOnlyCookies="false" requireSSL="false" />
    <trace enabled="true" localOnly="false" pageOutput="true" />
    <httpRuntime targetFramework="4.8" requestValidationMode="2.0" />
    <pages validateRequest="false" enableViewStateMac="false" />
    <machineKey validationKey="0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF" decryptionKey="FEDCBA9876543210FEDCBA9876543210" validation="HMACSHA256" decryption="AES" />
  </system.web>
</configuration>
