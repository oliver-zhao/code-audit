{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(npm run test *)",
      "Bash(git status:*)"
    ],
    "deny": [
      "Bash",
      "Bash(curl:*)",
      "Bash(rm -rf:*)",
      "Read(~/.ssh/**)"
    ]
  },
  "enabledMcpjsonServers": ["docs"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/format-check.mjs\"" }
        ]
      }
    ]
  }
}
